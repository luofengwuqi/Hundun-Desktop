{
  "name": "hundundesktop",
  "version": "1.0.0",
  "description": "HundunDesktop - 复古掌机风格的桌面效率工具",
  "homepage": "https://gitee.com/luofengwuqi",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "postinstall": "electron-builder install-app-deps",
    "gen-icon": "node scripts/gen-icon.js",
    "gen-icons": "python3 scripts/gen-linux-icons.py",
    "build:unpack": "npm run build && electron-builder --dir",
    "build:win": "npm run build && electron-builder --win nsis --x64",
    "build:mac": "npm run build && electron-builder --mac",
    "build:linux": "npm run build && electron-builder --linux AppImage deb --x64",
    "build:setup": "npm run build && electron-builder --win nsis --linux AppImage deb --x64"
  },
  "dependencies": {
    "pinia": "^2.1.7",
    "vue": "^3.4.0",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^5.0.0",
    "electron": "^28.3.3",
    "electron-builder": "^24.9.1",
    "electron-vite": "^2.0.0",
    "vite": "^5.0.0"
  },
  "build": {
    "appId": "com.hundun.desktop",
    "productName": "HundunDesktop",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "plugins/**/*",
      "sounds/**/*",
      "!node_modules"
    ],
    "extraResources": [],
    "asar": true,
    "afterAllArtifactBuild": "./scripts/patch-appimage.js",
    "win": {
      "target": "nsis",
      "icon": "src/renderer/assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "HundunDesktop",
      "artifactName": "${productName} Setup ${version}.${ext}"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "build/icons",
      "category": "Utility",
      "description": "Retro handheld style desktop efficiency tool",
      "maintainer": "HundunDesktop Team <hundundesktop@example.com>",
      "executableName": "hundundesktop"
    },
    "deb": {
      "packageName": "hundundesktop"
    }
  },
  "keywords": [
    "electron",
    "vue3",
    "efficiency",
    "productivity",
    "retro",
    "pixel-art"
  ],
  "author": "HundunDesktop Team",
  "license": "MIT",
  "allowScripts": {
    "electron@28.3.3": true
  }
}
